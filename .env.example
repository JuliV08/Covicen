# URL final del sitio (sin base). En GitHub Pages: https://<cuenta>.github.io
PUBLIC_SITE_URL=https://juliv08.github.io
# Base path. En Pages de un repo llamado covicen: /covicen/ . Con dominio propio: /
PUBLIC_BASE_PATH=/covicen/
# false mientras sea demo: noindex + robots cerrado. true cuando haya dominio.
# Desde el 06/10/2026 se indexa solo el sitio entero en el dominio oficial (src/lib/indexacion.ts). Para apagarlo en
# una emergencia: PUBLIC_NO_INDEXAR=true.
# PUBLIC_NO_INDEXAR=true
# EL INTERRUPTOR DE LO QUE SE PUBLICA. Desde el lanzamiento (06/10/2026), sin esta variable se publica el sitio entero;
# con false, solo la portada de «Próximamente». Ver README.
# PUBLIC_SITIO_COMPLETO=false
# local | api  (api no está implementada en v1)
FUENTE_DATOS=local
