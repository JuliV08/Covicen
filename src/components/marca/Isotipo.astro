---
// El isotipo de Covicen: la C con la ruta (manual de marca de septiembre de 2026, versión «ruta», desde el 06/10/2026).
// Los trazos y el degradado salen de src/assets/marca/marca.ts, que genera scripts/extraer-marca.mjs desde los SVG
// oficiales. En `tinta` (un solo color, como el separador) va el isotipo con las marcas caladas.
import DibujoMarca from './DibujoMarca.astro';
import { ISOTIPO, ISOTIPO_UN_COLOR } from '@/assets/marca/marca';

interface Props {
  variante?: 'degradado' | 'tinta';
  size?: number;
  class?: string;
  /** Si el isotipo es la única señal, pasá un título y deja de ser decorativo. */
  titulo?: string;
}
const { variante = 'degradado', size = 32, class: clase = '', titulo } = Astro.props;
---
{variante === 'tinta'
  ? <DibujoMarca dibujo={ISOTIPO_UN_COLOR} variante="tinta" width={size} height={size} class={clase} {titulo} />
  : <DibujoMarca dibujo={ISOTIPO} width={size} height={size} class={clase} {titulo} />}
