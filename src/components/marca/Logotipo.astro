---
// El logotipo de Covicen (manual de marca de septiembre de 2026, desde el 06/10/2026), con los trazos oficiales: nada
// de tipear «COVICEN» con la letra del sitio. Dos versiones del manual:
//   corto — isotipo y «COVICEN SA»: el header, donde el lema quedaría ilegible de chico.
//   largo — isotipo, «COVICEN SA» y «CORREDOR VIAL CENTRO»: el pie y la portada.
// Con `enlace` (el header) es un link a la home; sin él, una imagen con su nombre.
import DibujoMarca from './DibujoMarca.astro';
import { LOGO_CORTO, LOGO_LARGO } from '@/assets/marca/marca';
import { ruta } from '@/lib/rutas';

interface Props { version?: 'corto' | 'largo'; enlace?: boolean; class?: string }
const { version = 'corto', enlace = true, class: clase = '' } = Astro.props;
const dibujo = version === 'largo' ? LOGO_LARGO : LOGO_CORTO;
const nombre = version === 'largo' ? 'Covicen S.A., Corredor Vial Centro' : 'Covicen S.A.';
---
{enlace ? (
  <a href={ruta('/')} aria-label="Covicen, inicio" class:list={['logotipo inline-flex items-center no-underline', clase]}>
    <DibujoMarca dibujo={dibujo} class="logotipo-dibujo" />
  </a>
) : (
  <DibujoMarca dibujo={dibujo} class:list={['logotipo-dibujo', clase]} titulo={nombre} />
)}
<style>
  /* Sin enlace, el alto lo pone quien lo usa (una clase h-*); el ancho sale siempre de la proporción del dibujo. */
  :global(.logotipo-dibujo) { display: block; width: auto; }
  /* En el header: el corto mide unas 8,4 veces su alto. Entre 1024 y 1280 px comparte el renglón con el menú entero y
     con el botón del 140, así que ahí va más bajo. */
  .logotipo :global(.logotipo-dibujo) { height: 1.625rem; }
  @media (min-width: 64rem) { .logotipo :global(.logotipo-dibujo) { height: 1.125rem; } }
  @media (min-width: 80rem) { .logotipo :global(.logotipo-dibujo) { height: 1.75rem; } }
  .logotipo :global(.logo-isotipo) { transition: transform var(--dur-ui) var(--ease-salida); }
  .logotipo:hover :global(.logo-isotipo), .logotipo:focus-visible :global(.logo-isotipo) { transform: rotate(-6deg) scale(1.04); }
  @media (prefers-reduced-motion: reduce) { .logotipo:hover :global(.logo-isotipo), .logotipo:focus-visible :global(.logo-isotipo) { transform: none; } }
</style>
