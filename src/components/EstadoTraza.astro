---
// Estado de la traza "tipo subte", en vivo (spec del sistema 3, §8.6). El build emite solo el armazón; el navegador
// consulta la API y lo llena (scripts/estado-traza.ts → lib/estado-dom.ts): una fila por ruta con su chip (Sin avisos /
// Precaución / Corte) y los avisos debajo, lo programado de los próximos 7 días aparte y la última actualización.
// El estado nunca se decide en el build: una página estática que dijera «Sin avisos» lo seguiría diciendo horas
// después de un corte. Sin datos, o sin JS, el mensaje con el 140, nunca «Normal».
import { Car, CloudFog, Construction, Tractor, TriangleAlert } from '@lucide/astro';
import type { Incidente, NombreRuta } from '@/lib/datos/esquemas';
interface Props { /** Dirección completa de GET /api/v1/estado-ruta/ (lib/estado-publicado.ts). */ url: string; rutas: NombreRuta[]; nivel?: 'h2' | 'h3' }
const { url, rutas, nivel = 'h3' } = Astro.props;
const Titulo = nivel;
const Subtitulo = nivel === 'h2' ? 'h3' : 'h4';
// Los íconos van como <template>: el navegador clona el de cada tipo y no hace falta copiar los dibujos de lucide al JS.
const iconos: Record<Incidente['tipo'], typeof Car> = { transito: Car, obra: Construction, incidente: TriangleAlert, clima: CloudFog, mantenimiento: Tractor };
const FALLA = 'No pudimos consultar el estado de la ruta ahora. Probá de nuevo en unos minutos. Ante una emergencia, llamá al 140.';
---
<section class="estado-traza tarjeta p-6" aria-label="Estado de la traza" data-estado-en-vivo data-url={url} data-rutas={JSON.stringify(rutas)}>
  <Titulo class="text-xl">Estado de la traza</Titulo>
  <ul class="mt-4 divide-y divide-borde" data-estado-lista aria-live="polite"><li class="py-4 text-sm text-texto-2" data-estado-consultando>Consultando el estado de la ruta…</li></ul>
  <p class="mt-4 text-sm font-semibold text-texto" data-estado-error hidden>{FALLA}</p>
  <noscript><p class="mt-4 text-sm font-semibold text-texto">{FALLA}</p></noscript>
  <div class="mt-6 border-t border-borde pt-5" data-estado-programados hidden>
    <Subtitulo class="text-base">Programado</Subtitulo>
    <ul class="mt-3 flex flex-col gap-3" data-estado-programados-lista></ul>
  </div>
  <p class="mt-6 text-sm text-texto-2">Mostramos las obras, los cortes y los imprevistos que informa Covicen. Ante una emergencia, llamá al <a href="tel:140" class="font-semibold">140</a>.</p>
  <p class="anotacion mt-2 text-xs text-texto-2" data-estado-actualizado hidden></p>
  {Object.entries(iconos).map(([tipo, Icono]) => <template data-icono={tipo}><Icono size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-texto-2" /></template>)}
</section>
<style>
  /* Sin JS no hay consulta: «Consultando…» se va y queda solo el mensaje del <noscript>. */
  @media (scripting: none) { [data-estado-consultando] { display: none; } }
</style>
<script src="../scripts/estado-traza.ts"></script>
