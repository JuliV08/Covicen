---
import { Clock } from '@lucide/astro';
import Boton from '@/components/ui/Boton.astro';
import Senal from '@/components/ui/Senal.astro';
import { capacidades, type Capacidad } from '@/lib/datos/capacidades';
interface Props {
  capacidad: Capacidad;
  titulo: string;
  descripcion: string;
  alternativaHref?: string;
  alternativaTexto?: string;
  class?: string;
  /** Nivel del encabezado según dónde se inserta (h3 dentro de una sección con h2; h2 si cuelga del h1). */
  nivel?: 'h2' | 'h3';
}
const { capacidad, titulo, descripcion, alternativaHref, alternativaTexto, class: clase = '', nivel = 'h3' } = Astro.props;
const Titulo = nivel;
const activa: boolean = capacidades[capacidad];
---
{!activa && (
  <div class:list={['hueco tarjeta tarjeta-hueco p-6', clase]} data-capacidad={capacidad}>
    <div class="flex items-center gap-3"><Senal variante="frio"><Clock size={12} aria-hidden="true" /> Próximamente</Senal></div>
    <Titulo class="mt-4 text-[1.35rem]">{titulo}</Titulo>
    <p class="mt-2 text-texto-2">{descripcion}</p>
    {alternativaHref && alternativaTexto && (
      <div class="mt-5"><Boton href={alternativaHref} variante="secundario">{alternativaTexto}</Boton></div>
    )}
  </div>
)}
{activa && <slot />}
