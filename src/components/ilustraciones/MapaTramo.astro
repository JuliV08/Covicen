---
// Mapa esquemático del Tramo Centro. Las coordenadas (`mapa` de tramo.json, lienzo de 820 × 520) son contrato con el
// panel del backend y NO se cambian. Cada estación es un enlace con foco a su página; con JS (scripts/mapa.ts, desde
// MapaInteractivo) el toque muestra su ficha y el auto viaja hasta ella. Verde y punto lleno = operativa; amarillo y
// centro hueco = próxima (nada se comunica solo por color). Los incidentes del estado de la traza se ubican por km.
//
// Fase C (05/10/2026), «premium y caro, nada de líneas cortadas o dibujos SVG "así nomás"»: el viewBox se encuadra sobre
// lo dibujado; cada ruta es una cinta continua en tres capas (halo, cuerpo, filo) con curvas en los pueblos; se fueron
// la grilla, las marcas viales que fluían y la luz que recorría las rutas en loop; las estaciones son anillos nítidos y
// sus nombres van sobre una placa. Lo único que se mueve es el auto.
import { Bath, Coffee, ShieldCheck, Tag, Truck } from '@lucide/astro';
import { cabinaOperativa, type EstadoRuta, type Incidente, type Tramo } from '@/lib/datos/esquemas';
import { kmTexto } from '@/lib/formato';
import { estacionadoAntes, trazoRedondeado, type Red } from '@/lib/red';
import { ruta } from '@/lib/rutas';
import { cajaTexto, encuadreDelMapa, estadoCabina, leyendaServicios, puntoEnRuta, rotulosDelMapa, TAM_ROTULO, type ClaveServicio } from '@/lib/tramo';
interface Props { tramo: Tramo; incidentes?: NonNullable<EstadoRuta['incidentes']>; modo?: 'scroll' | 'cargar'; class?: string; /** Distinto por mapa si hay más de uno en la página. */ idTitulo?: string }
const { tramo, incidentes = [], modo = 'scroll', class: clase = '', idTitulo = 'mapa-titulo' } = Astro.props;
const porSlug = new Map(tramo.ciudades.map((c) => [c.slug, c]));
const ciudad = (s: string) => {
  const c = porSlug.get(s);
  if (!c) throw new Error(`MapaTramo: la ciudad "${s}" no existe en tramo.json`);
  return c;
};
const claseBaliza = modo === 'scroll' ? 'baliza' : 'baliza al-cargar';
// Dónde va cada rótulo, sin pisarse, y qué parte del lienzo se muestra (lib/tramo.ts).
const rotulos = rotulosDelMapa(tramo);
const rotuloRuta = new Map(rotulos.rutas.map((r) => [r.ruta, r]));
const rotuloCiudad = new Map(rotulos.ciudades.map((r) => [r.slug, r]));
const encuadre = encuadreDelMapa(tramo);
// La placa de cada rótulo de estación: una para el tamaño de pantallas chicas y otra para el de pantalla grande (las
// letras cambian de tamaño, el ancla no). 4 de aire a los costados, 3 arriba y abajo.
const placa = (x: number, y: number, nombre: string, tam: number) => {
  const c = cajaTexto({ x, y, ancla: 'middle' }, nombre.toUpperCase(), tam, TAM_ROTULO.cabina.factor);
  return { x: c.x0 - 4, y: c.y0 - 3, width: c.x1 - c.x0 + 8, height: c.y1 - c.y0 + 6 };
};
// La red, para que scripts/mapa.ts calcule el viaje del auto en el navegador sin traer el esquema de datos.
const red: Red = { ciudades: tramo.ciudades.map((c) => ({ slug: c.slug, mapa: c.mapa })), trazados: tramo.trazados.map((t) => ({ ciudades: t.ciudades })) };
// El auto arranca estacionado en la primera operativa, mirando hacia el nodo que sigue en su trazado.
const inicial = tramo.cabinas.find(cabinaOperativa) ?? tramo.cabinas[0]!;
const trazadoInicial = tramo.trazados.find((t) => t.ciudades.includes(inicial.slug))!;
const enTrazado = trazadoInicial.ciudades.indexOf(inicial.slug);
const vecino = ciudad(trazadoInicial.ciudades[enTrazado + 1] ?? trazadoInicial.ciudades[enTrazado - 1]!).mapa;
const rumboInicial = Math.round((Math.atan2(vecino.y - inicial.mapa.y, vecino.x - inicial.mapa.x) * 180) / Math.PI);
// Estacionado sobre la ruta, unas unidades antes de la estación, para no tapar su punto de estado.
const autoEn = estacionadoAntes(inicial.mapa, rumboInicial);
const titulo = `Mapa esquemático del Tramo Centro: ${tramo.rutas.map((r) => r.nombre).join(', ')} entre ${tramo.ciudades.filter((c) => c.principal).map((c) => c.nombre).join(', ')}, con ${tramo.cabinas.length} estaciones de peaje.`;
const iconos: Record<ClaveServicio, typeof Coffee> = { areaDescanso: Coffee, detencionSegura: ShieldCheck, gruaGratuita: Truck, sanitarios: Bath, colocacionTelepase: Tag };
const marcadores = incidentes.flatMap((inc) => { const p = inc.km === null ? null : puntoEnRuta(tramo, inc.ruta, inc.km); return p ? [{ ...inc, p }] : []; });
// La severidad no se comunica solo por color (spec §7.1): cambia la FORMA del marcador (triángulo = corte, rombo =
// precaución, círculo = info), se nombra en el <title> y la leyenda repite forma y nombre. El relleno es el refuerzo.
const SEVERIDAD: Record<Incidente['severidad'], string> = { corte: 'Corte', precaucion: 'Precaución', info: 'Información' };
const FORMA: Record<Incidente['severidad'], string> = { corte: 'M0 -10 L9 6 L-9 6 Z', precaucion: 'M0 -9 L9 0 L0 9 L-9 0 Z', info: 'M-8 0 A8 8 0 1 0 8 0 A8 8 0 1 0 -8 0 Z' };
const severidades = (['corte', 'precaucion', 'info'] as const).filter((s) => marcadores.some((m) => m.severidad === s));
const id = (nombre: string) => `${idTitulo}-${nombre}`;
---
<figure class:list={['mapa', clase]}>
  <p id={idTitulo} class="sr-only">{titulo}</p>
  <svg viewBox={`${encuadre.x} ${encuadre.y} ${encuadre.ancho} ${encuadre.alto}`} role="group" aria-labelledby={idTitulo} class="block h-auto w-full" data-red={JSON.stringify(red)}>
    <defs>
      <radialGradient id={id('fondo')} cx="50%" cy="45%" r="70%">
        <stop offset="0" stop-color="var(--color-superficie)" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="var(--color-superficie)" stop-opacity="0"></stop>
      </radialGradient>
      {/* El fondo de puntos (05/10/2026, Juli: «el anterior tenía un grid sutil»): una retícula de puntitos, más
          marcada en el centro y que se pierde hacia los bordes. Textura de plano, sin líneas que compitan con las rutas. */}
      <pattern id={id('puntos')} width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="8" cy="8" r="0.9" fill="var(--color-texto)"></circle></pattern>
      <radialGradient id={id('desvanecer')} cx="50%" cy="50%" r="62%">
        <stop offset="0" stop-color="white" stop-opacity="1"></stop>
        <stop offset="1" stop-color="white" stop-opacity="0"></stop>
      </radialGradient>
      <mask id={id('mascara')}><rect x={encuadre.x} y={encuadre.y} width={encuadre.ancho} height={encuadre.alto} fill={`url(#${id('desvanecer')})`}></rect></mask>
      <filter id={id('halo')} x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="3"></feGaussianBlur></filter>
      <filter id={id('sombra')} x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="1.4"></feGaussianBlur></filter>
      <linearGradient id={id('carroceria')} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--color-sobre-marca)"></stop>
        <stop offset="1" stop-color="var(--color-texto-2)"></stop>
      </linearGradient>
      <linearGradient id={id('techo')} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--color-texto-2)"></stop>
        <stop offset="1" stop-color="var(--color-sobre-marca)"></stop>
      </linearGradient>
      <linearGradient id={id('faro')} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--color-acento)" stop-opacity="0.5"></stop>
        <stop offset="1" stop-color="var(--color-acento)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <rect x={encuadre.x} y={encuadre.y} width={encuadre.ancho} height={encuadre.alto} fill={`url(#${id('fondo')})`}></rect>
    <rect x={encuadre.x} y={encuadre.y} width={encuadre.ancho} height={encuadre.alto} fill={`url(#${id('puntos')})`} mask={`url(#${id('mascara')})`} opacity="0.16"></rect>
    {tramo.trazados.map((t) => {
      const d = trazoRedondeado(t.ciudades.map((s) => ciudad(s).mapa));
      return (
        <g class="ruta">
          <path d={d} class="ruta-halo" fill="none" stroke="var(--color-glow)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" filter={`url(#${id('halo')})`} pathLength="1000"></path>
          <path d={d} class="ruta-cuerpo" fill="none" stroke="var(--color-borde-fuerte)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" pathLength="1000"></path>
          <path d={d} class="ruta-filo" fill="none" stroke="var(--color-acento)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1000"></path>
          <text x={rotuloRuta.get(t.ruta)!.x} y={rotuloRuta.get(t.ruta)!.y} class="ruta-etiqueta" text-anchor="middle">{t.ruta}</text>
        </g>
      );
    })}
    {tramo.ciudades.map((c) => (
      <g>
        {c.tipo === 'empalme' ? (
          <rect x={c.mapa.x - 2.5} y={c.mapa.y - 2.5} width="5" height="5" rx="1" fill="var(--color-fondo)" stroke="var(--color-acento)" stroke-width="1.25"></rect>
        ) : (
          <circle cx={c.mapa.x} cy={c.mapa.y} r={c.principal ? 4.5 : 3} fill="var(--color-fondo)" stroke="var(--color-acento)" stroke-width="1.25"></circle>
        )}
        {c.principal && (
          <text x={rotuloCiudad.get(c.slug)!.x} y={rotuloCiudad.get(c.slug)!.y} class="ciudad-etiqueta" text-anchor={rotuloCiudad.get(c.slug)!.ancla}>{c.nombre}</text>
        )}
      </g>
    ))}
    {marcadores.map((m) => (
      <g class="incidente" role="img" data-severidad={m.severidad} transform={`translate(${m.p.x} ${m.p.y})`}>
        <title>{`${SEVERIDAD[m.severidad]} — ${m.ruta}${m.km !== null ? ` km ${kmTexto(m.km)}` : ''}: ${m.descripcion}`}</title>
        <path d={FORMA[m.severidad]} class="incidente-forma" stroke="var(--color-fondo)" stroke-width="1.5" stroke-linejoin="round"></path>
        <circle cy="1" r="1.4" fill="var(--color-fondo)"></circle>
      </g>
    ))}
    {tramo.cabinas.map((cab, i) => {
      const e = estadoCabina(cab);
      const { x, y } = cab.mapa;
      return (
        <a href={ruta(`/peajes/${cab.slug}`)} class={claseBaliza} style={`--i: ${i}`} data-estacion={cab.slug} data-estado-operativo={e.clave} aria-label={`Estación ${cab.nombre}, ${cab.ruta}${cab.km !== null ? ` km ${kmTexto(cab.km)}` : ''}, ${e.etiqueta.toLowerCase()}`}>
          <circle cx={x} cy={y} r="14" class="baliza-halo" opacity="0.16"></circle>
          <circle cx={x} cy={y} r="19" class="baliza-foco" fill="none" stroke-width="2"></circle>
          <circle cx={x} cy={y} r="10" class="baliza-anillo" fill="var(--color-fondo)" stroke-width="1.5"></circle>
          <circle cx={x} cy={y} r="5" class:list={['baliza-punto', e.clave === 'proxima' && 'baliza-hueca']}></circle>
          <g class="cabina-rotulo">
            <rect {...placa(x, y - 18, cab.nombre, 14)} rx="4" class="cabina-placa"></rect>
            <rect {...placa(x, y - 18, cab.nombre, 11.5)} rx="4" class="cabina-placa-lg"></rect>
            <text x={x} y={y - 18} class="cabina-etiqueta" text-anchor="middle">{cab.nombre}</text>
          </g>
        </a>
      );
    })}
    {/* El auto (fase C): visto desde arriba, dibujado mirando hacia la derecha y centrado en 0,0, unas 22 × 11 unidades.
        Decorativo: lo mueve scripts/mapa.ts y todo lo que comunica el mapa sigue en las estaciones y la ficha. */}
    <g class="auto" aria-hidden="true" data-auto data-estacion-auto={inicial.slug} data-rumbo={rumboInicial} transform={`translate(${autoEn.x} ${autoEn.y}) rotate(${rumboInicial})`}>
      <ellipse cx="0.8" cy="1.8" rx="12.5" ry="6.6" fill="var(--color-sombra)" opacity="0.6" filter={`url(#${id('sombra')})`}></ellipse>
      <path d="M10.5 -4 L26 -8.5 L26 -0.8 Z M10.5 4 L26 0.8 L26 8.5 Z" fill={`url(#${id('faro')})`}></path>
      <rect x="-11" y="-5.5" width="22" height="11" rx="4" fill={`url(#${id('carroceria')})`} stroke="var(--color-marca-900)" stroke-opacity="0.55" stroke-width="0.5"></rect>
      <rect x="-5.4" y="-4.3" width="7.6" height="8.6" rx="1.8" fill={`url(#${id('techo')})`}></rect>
      <rect x="2.6" y="-4.3" width="4.4" height="8.6" rx="1.6" fill="var(--color-marca-900)"></rect>
      <rect x="-8.8" y="-3.9" width="3.1" height="7.8" rx="1.3" fill="var(--color-marca-900)" opacity="0.9"></rect>
      <rect x="-4.6" y="-3.5" width="5.8" height="1.1" rx="0.55" fill="var(--color-sobre-marca)" opacity="0.75"></rect>
      <rect x="9.6" y="-4.6" width="1.5" height="2.2" rx="0.6" fill="var(--color-sobre-marca)"></rect>
      <rect x="9.6" y="2.4" width="1.5" height="2.2" rx="0.6" fill="var(--color-sobre-marca)"></rect>
      <rect x="-11.3" y="-4.4" width="1.1" height="2" rx="0.5" fill="var(--color-error)"></rect>
      <rect x="-11.3" y="2.4" width="1.1" height="2" rx="0.5" fill="var(--color-error)"></rect>
    </g>
  </svg>
  <figcaption class="mt-4 text-sm text-texto-2">
    <ul class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Leyenda">
      <li class="inline-flex items-center gap-2"><span class="inline-block h-0.5 w-6 bg-acento" aria-hidden="true"></span> Rutas del tramo</li>
      <li class="inline-flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-ok" aria-hidden="true"></span> Estación operativa</li>
      <li class="inline-flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full border-2 border-vial-texto" aria-hidden="true"></span> Estación próxima</li>
      <li class="inline-flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full border-2 border-acento" aria-hidden="true"></span> Ciudad</li>
      {leyendaServicios(tramo).map((s) => { const Icono = iconos[s.clave]; return <li class="inline-flex items-center gap-2"><Icono size={14} aria-hidden="true" /> {s.etiqueta}</li>; })}
      {severidades.map((s) => (
        <li class="inline-flex items-center gap-2">
          <svg viewBox="-12 -12 24 24" width="14" height="14" aria-hidden="true" class="incidente" data-severidad={s}><path d={FORMA[s]} class="incidente-forma"></path></svg> {SEVERIDAD[s]}
        </li>
      ))}
    </ul>
  </figcaption>
</figure>
<style>
  .mapa text { font-family: var(--font-sans); fill: var(--color-texto-2); }
  /* Estos font-size son unidades del dibujo, no píxeles: el CSS escala el SVG al ancho del panel. Los de acá son para
     pantallas de 768 a 1023 px (el mapa, unos 682 px de ancho); los de abajo, para 1024 en adelante (desde unos 922 px).
     Lo guarda tests/styles/legibilidad.test.ts: ninguno baja de 12 px en pantalla. */
  .ruta-etiqueta { font-size: 15px; font-weight: 800; letter-spacing: 0.12em; fill: var(--color-acento); }
  .ciudad-etiqueta { font-size: 17px; font-weight: 500; fill: var(--color-texto); }
  .cabina-etiqueta { font-size: 14px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  /* El nombre de cada estación va sobre una placa: se lee siempre igual, pase lo que pase por detrás. En pantallas
     angostas se ve solo el de la elegida (o el que tiene el puntero o el foco). */
  .cabina-rotulo { opacity: 0; transition: opacity var(--dur-ui) var(--ease-salida); }
  .cabina-placa, .cabina-placa-lg { fill: var(--color-fondo-2); stroke: var(--color-borde); stroke-width: 1; }
  .cabina-placa-lg { display: none; }
  /* Los <a> del SVG son botones del mapa: sin el subrayado de la regla global de enlaces. */
  .baliza { cursor: pointer; outline: none; text-decoration: none; }
  /* Los selectores por estado (0,3,0) le ganan a `.mapa text` (0,1,1). */
  .baliza[data-estado-operativo="operativa"] .baliza-halo, .baliza[data-estado-operativo="operativa"] .baliza-punto { fill: var(--color-ok); }
  .baliza[data-estado-operativo="operativa"] .baliza-anillo { stroke: var(--color-ok); }
  .baliza[data-estado-operativo="operativa"] .cabina-etiqueta { fill: var(--color-ok); }
  /* Próxima: anillo y centro hueco con vial-texto (no con vial: acá el amarillo es primer plano sobre el panel y
     --color-vial no llega al 3:1 de WCAG 1.4.11). Se distingue de la operativa por la forma, no solo por el color. */
  .baliza[data-estado-operativo="proxima"] .baliza-halo { fill: var(--color-vial-texto); }
  .baliza[data-estado-operativo="proxima"] .baliza-anillo { stroke: var(--color-vial-texto); }
  .baliza[data-estado-operativo="proxima"] .cabina-etiqueta { fill: var(--color-vial-texto); }
  .baliza-hueca { fill: var(--color-fondo); stroke: var(--color-vial-texto); stroke-width: 2; }
  /* Foco de teclado y estación elegida: anillo con el acento (el outline no se dibuja en <a> de SVG). */
  .baliza-foco { stroke: var(--color-acento); opacity: 0; transition: opacity var(--dur-micro); }
  .baliza:focus-visible .baliza-foco, .baliza[aria-current="true"] .baliza-foco { opacity: 1; }
  .baliza:hover .cabina-rotulo, .baliza:focus-visible .cabina-rotulo, .baliza[aria-current="true"] .cabina-rotulo { opacity: 1; }
  .baliza-halo { transform-box: fill-box; transform-origin: center; transition: transform var(--dur-ui) var(--ease-salida), opacity var(--dur-ui); }
  .baliza:hover .baliza-halo, .baliza:focus-visible .baliza-halo { transform: scale(1.5); opacity: 0.4; }
  .incidente-forma { fill: var(--color-acento); }
  .incidente[data-severidad="precaucion"] .incidente-forma { fill: var(--color-vial-texto); }
  .incidente[data-severidad="corte"] .incidente-forma { fill: var(--color-error); }
  .auto { pointer-events: none; }
  /* Las rutas se dibujan una vez al entrar en pantalla: scripts/mapa.ts pone data-dibujo="espera" al montar y "listo"
     cuando el mapa se ve. Sin JS o con «reducir movimiento» no pone nada y las rutas están dibujadas desde el principio.
     (Hasta el 05/10/2026 el dibujo iba atado al scroll con `.dibujar.al-scroll`, pero el minificador de CSS borraba el
     `animation` y el `animation-timeline` en el sitio armado y las rutas quedaban escondidas.) */
  svg[data-dibujo] .ruta > path { stroke-dasharray: 1000; stroke-dashoffset: 1000; }
  svg[data-dibujo="listo"] .ruta > path { animation: ruta-dibujar 1.6s var(--ease-suave) 150ms both; }
  @keyframes ruta-dibujar { to { stroke-dashoffset: 0; } }
  @media (min-width: 48rem) { .cabina-rotulo { opacity: 1; } }
  @media (min-width: 64rem) {
    .ruta-etiqueta { font-size: 12px; }
    .ciudad-etiqueta { font-size: 13px; }
    .cabina-etiqueta { font-size: 11.5px; }
    .cabina-placa { display: none; }
    .cabina-placa-lg { display: inline; }
  }
</style>
