---
import type { Pregunta } from '@/lib/datos/esquemas';
import { preguntasPublicables } from '@/lib/faq';
interface Props { preguntas: Pregunta[]; class?: string }
const { preguntas: recibidas, class: clase = '' } = Astro.props;
// El filtro se aplica ACA y no (solo) en la pagina: este es el unico componente que renderiza preguntas en todo el
// sitio, asi que dejar de publicar una respuesta sin certificar no depende de que alguien se acuerde de llamarlo.
// La pagina igual lo llama antes, porque el JSON-LD tiene que salir de la misma lista; esto es el piso.
const preguntas = preguntasPublicables(recibidas);
// 05/10/2026: cada pregunta es una tarjeta con luz que sigue al mouse (.tarjeta-luz) y un + que se vuelve ×; la
// respuesta ocupa todo el ancho de la tarjeta. Antes eran renglones separados por rayas, con la respuesta angosta y un
// hueco a la derecha.
---
<div class:list={['faq escalonar grid gap-3', clase]}>
  {preguntas.map((p, i) => (
    <details class="faq-item tarjeta-luz scroll-mt-[calc(var(--alto-header)+5rem)] lg:scroll-mt-[calc(var(--alto-header)+2rem)]" id={p.slug} style={`--i: ${i}`} data-spotlight>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-5 py-4 text-left font-semibold text-texto sm:px-6 sm:py-5">
        <span>{p.pregunta}</span>
        <span class="faq-signo" aria-hidden="true"></span>
      </summary>
      <div class="faq-cuerpo"><div><p class="px-5 pb-5 text-texto-2 sm:px-6 sm:pb-6">{p.respuesta}</p></div></div>
    </details>
  ))}
</div>
<script>
  // Un link a /preguntas-frecuentes/#slug abre la pregunta en vez de dejarla cerrada.
  const abrirPorHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const d = document.getElementById(id);
    if (d instanceof HTMLDetailsElement) d.open = true;
  };
  document.addEventListener('astro:page-load', abrirPorHash);
  window.addEventListener('hashchange', abrirPorHash);
</script>
<style>
  .faq-item summary::-webkit-details-marker { display: none; }
  /* El foco de teclado va en la tarjeta: el summary la ocupa de borde a borde y su anillo, que se dibuja afuera, lo
     recortaba el overflow de .tarjeta-luz (revisión del 05/10/2026). El contorno propio no lo recorta su overflow. */
  .faq-item summary:focus-visible { outline: none; }
  .faq-item:has(> summary:focus-visible) { outline: 2px solid var(--color-acento); outline-offset: 2px; }
  .faq-item summary:hover { color: var(--color-texto); }
  .faq-item[open] {
    border-color: color-mix(in srgb, var(--color-acento) 40%, transparent);
    box-shadow: 0 18px 40px -28px var(--color-sombra), 0 0 0 1px color-mix(in srgb, var(--color-acento) 12%, transparent);
  }
  /* El + dibujado con dos rayas en un círculo: al abrir gira 45° y queda una ×. */
  .faq-signo {
    position: relative; flex-shrink: 0; width: 2rem; height: 2rem; border-radius: 999px;
    border: 1px solid var(--color-borde-fuerte); color: var(--color-texto-2);
    transition: transform var(--dur-ui) var(--ease-salida), color var(--dur-micro), border-color var(--dur-micro), background-color var(--dur-micro);
  }
  .faq-signo::before, .faq-signo::after {
    content: ""; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 2px; border-radius: 2px;
    background: currentColor; translate: -50% -50%;
  }
  .faq-signo::after { rotate: 90deg; }
  .faq-item summary:hover .faq-signo { border-color: var(--color-acento); color: var(--color-acento); }
  .faq-item[open] .faq-signo {
    transform: rotate(45deg); color: var(--color-acento);
    border-color: color-mix(in srgb, var(--color-acento) 55%, transparent); background: color-mix(in srgb, var(--color-acento) 12%, transparent);
  }
  .faq-cuerpo { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--dur-ui) var(--ease-salida); }
  .faq-cuerpo > div { overflow: hidden; }
  .faq-item[open] .faq-cuerpo { grid-template-rows: 1fr; }
  @supports (interpolate-size: allow-keywords) {
    .faq-item { interpolate-size: allow-keywords; }
    .faq-item::details-content { block-size: 0; overflow: hidden; transition: block-size var(--dur-ui) var(--ease-salida), content-visibility var(--dur-ui) allow-discrete; }
    .faq-item[open]::details-content { block-size: auto; }
    .faq-cuerpo { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .faq-signo { transition: none; } }
</style>
