---
// Progreso de lectura en mobile: barra fina bajo el header (en desktop la scrollbar nativa ya está estilizada con los tokens).
---
<div class="hilo-mobile lg:hidden" aria-hidden="true"></div>
<style>
  .hilo-mobile { position: fixed; left: 0; top: var(--alto-header); height: 2px; width: 100%; background: var(--color-acento); box-shadow: 0 0 8px var(--color-glow); transform-origin: left; transform: scaleX(0); z-index: 30; pointer-events: none; }
  @supports (animation-timeline: scroll()) {
    .hilo-mobile { animation: crecer linear both; animation-timeline: scroll(root); }
  }
  @supports not (animation-timeline: scroll()) { .hilo-mobile { display: none !important; } }
  @keyframes crecer { to { transform: scaleX(1); } }
</style>
