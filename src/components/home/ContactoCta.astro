---
import { ArrowRight, MessageCircle, Phone } from '@lucide/astro';
import Boton from '@/components/ui/Boton.astro';
import type { Contacto } from '@/lib/datos/esquemas';
import { sinCortes } from '@/lib/texto';
import { enlaceWhatsapp } from '@/lib/whatsapp';
interface Props { contacto: Contacto }
const { contacto } = Astro.props;
const linea = contacto.lineaGratuita;
---
<section class="seccion-tono relative py-24">
  <span class="costura costura-arriba" aria-hidden="true"></span>
  <div class="contenedor revelar relative z-10 flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="eyebrow">Contacto</p>
      <h2 class="titulo mt-3">¿Consultas, reclamos?</h2>
      {/* Decía «Escribinos por WhatsApp: completá el formulario con tus datos y el motivo». Desde el 01/10/2026 el
          formulario es el del CRM (Bitrix24), no manda por WhatsApp ni pide motivo: el texto dice solo lo que vale
          con los dos formularios, el del CRM y el propio. */}
      <p class="mt-3 max-w-xl text-texto-2">Dejanos tu consulta, reclamo o sugerencia en el formulario de Contacto, con tus datos para responderte{linea ? `, o llamanos gratis al ${sinCortes(linea)}` : ''}.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Boton href="/contacto">Ir al formulario <ArrowRight size={18} aria-hidden="true" /></Boton>
      {/* La línea 0800 (05/10/2026). El rótulo va en aria-label: el texto visible es solo el número, sin cortes. */}
      {linea && (
        <Boton href={`tel:${linea.replace(/[^\d+]/g, '')}`} variante="secundario" ariaLabel={`Llamar a atención al usuario, ${linea}`}><Phone size={18} aria-hidden="true" /> {sinCortes(linea)}</Boton>
      )}
      {contacto.whatsapp.numero && (
        <Boton href={enlaceWhatsapp(contacto.whatsapp.numero, 'Hola Covicen, quiero hacer una consulta.')} variante="secundario" externo><MessageCircle size={18} aria-hidden="true" /> WhatsApp directo</Boton>
      )}
    </div>
  </div>
  <span class="costura costura-abajo" aria-hidden="true"></span>
</section>
