---
import { ArrowRight, Clock, Mail, MessageCircle, Phone } from '@lucide/astro';
import Boton from '@/components/ui/Boton.astro';
import Correo from '@/components/ui/Correo.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { Contacto } from '@/lib/datos/esquemas';
import { horaSinCorte, sinCortes } from '@/lib/texto';
import { enlaceWhatsapp } from '@/lib/whatsapp';
interface Props { contacto: Contacto }
const { contacto } = Astro.props;
const linea = contacto.lineaGratuita;
const horario = contacto.horarioAtencion;
const correo = contacto.atencionUsuario;
---
<section class="seccion-tono relative py-24">
  <span class="costura costura-arriba" aria-hidden="true"></span>
  {/* Una columna centrada desde la fase A (05/10/2026), como los demás encabezados: antes era una fila con el texto a
      la izquierda y los botones a la derecha. */}
  <div class="contenedor revelar relative z-10 flex flex-col items-center gap-6 text-center">
    <div>
      <Eyebrow centrado>Contacto</Eyebrow>
      <h2 class="titulo mx-auto mt-3">¿Consultas, reclamos?</h2>
      {/* Decía «Escribinos por WhatsApp: completá el formulario con tus datos y el motivo». Desde el 01/10/2026 el
          formulario es el del CRM (Bitrix24), no manda por WhatsApp ni pide motivo: el texto dice solo lo que vale
          con los dos formularios, el del CRM y el propio. */}
      <p class="mx-auto mt-3 max-w-xl text-texto-2">Dejanos tu consulta, reclamo o sugerencia en el formulario de Contacto, con tus datos para responderte{linea ? `, o llamanos gratis al ${sinCortes(linea)}` : ''}.</p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <Boton href="/contacto">Ir al formulario <ArrowRight size={18} aria-hidden="true" /></Boton>
      {/* La línea 0800 (05/10/2026). El rótulo va en aria-label: el texto visible es solo el número, sin cortes. */}
      {linea && (
        <Boton href={`tel:${linea.replace(/[^\d+]/g, '')}`} variante="secundario" ariaLabel={`Llamar a atención al usuario, ${linea}`}><Phone size={18} aria-hidden="true" /> {sinCortes(linea)}</Boton>
      )}
      {contacto.whatsapp.numero && (
        <Boton href={enlaceWhatsapp(contacto.whatsapp.numero, 'Hola Covicen, quiero hacer una consulta.')} variante="secundario" externo><MessageCircle size={18} aria-hidden="true" /> WhatsApp directo</Boton>
      )}
    </div>
    {/* Horario y correo de atención al usuario (29/10/2026). El correo va como texto y no como botón: con sus 32 letras,
        a 320 px no entra en uno. */}
    {(horario || correo) && (
      <ul class="flex max-w-full flex-col items-center gap-x-6 gap-y-2 text-sm text-texto-2 sm:flex-row sm:flex-wrap sm:justify-center" aria-label="Atención al usuario">
        {horario && <li class="inline-flex items-center gap-2"><Clock size={16} aria-hidden="true" class="shrink-0 text-acento" /><span><span class="sr-only">Horario de atención: </span>{horaSinCorte(horario)}</span></li>}
        {correo && <li class="inline-flex min-w-0 max-w-full items-center gap-2"><Mail size={16} aria-hidden="true" class="shrink-0 text-acento" /><a href={`mailto:${correo}`} class="min-w-0 [overflow-wrap:anywhere]"><Correo correo={correo} /></a></li>}
      </ul>
    )}
  </div>
  <span class="costura costura-abajo" aria-hidden="true"></span>
</section>
