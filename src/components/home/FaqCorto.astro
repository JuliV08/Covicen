---
import { ArrowRight } from '@lucide/astro';
import Faq from '@/components/Faq.astro';
import Boton from '@/components/ui/Boton.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { Pregunta } from '@/lib/datos/esquemas';
interface Props { preguntas: Pregunta[] }
const { preguntas } = Astro.props;
---
<section id="faq" class="py-20 md:py-28">
  <div class="contenedor grid gap-10 lg:grid-cols-[1fr_1.7fr] lg:gap-16">
    <header class="revelar lg:sticky lg:top-28 lg:self-start">
      <div class="grid gap-4 md:grid-cols-[auto_1fr] md:gap-10 lg:grid-cols-1 lg:gap-4">
        <span class="eyebrow tabular-nums text-texto-3">07</span>
        <div>
          <Eyebrow>Preguntas frecuentes</Eyebrow>
          <h2 class="mt-3">Lo que más se pregunta.</h2>
          <p class="mt-4 text-lg text-texto-2">Las cinco respuestas que resuelven la mayoría de las consultas del automovilista.</p>
          <div class="mt-8"><Boton href="/preguntas-frecuentes" variante="secundario">Todas las preguntas <ArrowRight size={18} aria-hidden="true" /></Boton></div>
        </div>
      </div>
    </header>
    <Faq preguntas={preguntas.filter((p) => p.enHome)} />
  </div>
</section>
