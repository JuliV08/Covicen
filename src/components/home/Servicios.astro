---
import { CreditCard, LifeBuoy, ShieldCheck } from '@lucide/astro';
import Card from '@/components/ui/Card.astro';
import Seccion from '@/components/ui/Seccion.astro';
interface Props { id?: string; titulo?: string; eyebrow?: string }
const { id = 'servicios', titulo = 'Lo que cubre el peaje.', eyebrow = 'Servicios al usuario' } = Astro.props;
const servicios = [
  { Icono: LifeBuoy, titulo: 'Emergencias 140 y auxilio', texto: 'Llamá al 140, gratis y las 24 horas. Grúa y remolque sin cargo para despejar la calzada, con tiempos comprometidos.', href: '/emergencias' },
  { Icono: ShieldCheck, titulo: 'Seguridad vial', texto: 'Móviles de seguridad en RN 9 y RN 19, señalización de obras y consejos para manejar mejor en el centro del país.', href: '/seguridad-vial' },
  { Icono: CreditCard, titulo: 'Medios de pago', texto: 'TelePASE gratis y en todas las estaciones, y pago en la vía donde haya cabinas.', href: '/medios-de-pago' },
];
---
{/* FUERA DE LA HOME desde el 20/09/2026 (call con el gerente: la home queda en portada, accesos, El tramo con el
    mapa, novedades y cierre de contacto, y nada más). El componente NO se borra: la decisión es de recorte, no de
    contenido, y volver a ponerlo es una línea de import en components/home/Home.astro. Lo que SÍ está prohibido es
    reponerlo sin decirlo: tests/components/home.test.ts exige que la home tenga esas cinco secciones y ninguna más.
    Los servicios viven en /servicios/. OJO: el comentario que estaba acá decía que este componente lo usaban la home Y /servicios/, y era falso: esa página arma su propio contenido desde servicios.json. Hoy no lo usa nadie. */}
<Seccion {id} {eyebrow} {titulo} fondo="plano">
  <ul class="escalonar grid gap-4 md:grid-cols-3">
    {servicios.map(({ Icono, ...s }, i) => (
      <li style={`--i: ${i}`}>
        <Card href={s.href}>
          <Icono size={28} aria-hidden="true" class="text-acento" />
          <h3 class="mt-4 text-xl">{s.titulo}</h3>
          <p class="mt-2 text-texto-2">{s.texto}</p>
        </Card>
      </li>
    ))}
  </ul>
</Seccion>
