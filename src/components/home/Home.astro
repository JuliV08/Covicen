---
import Base from '@/layouts/Base.astro';
import AccesosRapidos from '@/components/home/AccesosRapidos.astro';
import ContactoCta from '@/components/home/ContactoCta.astro';
import ElTramo from '@/components/home/ElTramo.astro';
import Hero from '@/components/home/Hero.astro';
import NovedadesRecientes from '@/components/home/NovedadesRecientes.astro';
import Marquesina from '@/components/Marquesina.astro';
import { datos } from '@/lib/datos';

const [empresa, contacto, avisos, tramo, novedades] = await Promise.all([
  datos.empresa(),
  datos.contacto(),
  datos.avisos(),
  datos.tramo(),
  datos.novedades(),
]);
---
<Base titulo="Inicio" descripcion="Covicen, concesionaria del Tramo Centro de la Red Federal de Concesiones: 679 km sobre RN 9, RN 19 y RN 34 en Córdoba y Santa Fe. Tarifas, peajes, medios de pago y emergencias." marquesinaEnHero>
  {/* En la home la cinta se apoya en el borde de abajo del hero; en el resto de las páginas la monta Base, arriba
      del contenido. Por eso Base recibe `marquesinaEnHero` y acá va por el slot. */}
  <Hero {empresa}><Marquesina slot="marquesina" {avisos} enHero /></Hero>
  <AccesosRapidos {contacto} />
  <ElTramo {tramo} />
  <NovedadesRecientes {novedades} />
  <ContactoCta {contacto} />
</Base>
