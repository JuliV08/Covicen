---
import { ArrowRight } from '@lucide/astro';
import MapaInteractivo from '@/components/MapaInteractivo.astro';
import Boton from '@/components/ui/Boton.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Mojon from '@/components/ui/Mojon.astro';
import Seccion from '@/components/ui/Seccion.astro';
import type { Tramo } from '@/lib/datos/esquemas';
import { cabinaOperativa } from '@/lib/datos/esquemas';
interface Props { tramo: Tramo }
const { tramo } = Astro.props;
const operativas = tramo.cabinas.filter(cabinaOperativa).length;
// Título institucional (call del 20/09/2026), y es el MISMO que el gerente dio por perfecto en la sección 01 de
// /el-tramo/: la home y la página interior dicen lo mismo en vez de dos cosas parecidas.
// Las rutas y las provincias salen del dato, nunca escritas a mano; la coma final se vuelve "y".
const enumerar = (xs: string[]) => xs.join(', ').replace(/, ([^,]*)$/, ' y $1');
const rutas = enumerar(tramo.rutas.map((r) => r.nombre));
const provincias = enumerar(tramo.provincias);
// Fase C (05/10/2026): el título, la bajada y los números van adentro del panel, en la columna del mapa
// (MapaInteractivo): desde 1280 px se ve todo junto, sin subir para leer el título ni bajar para ver la ficha. En esos
// anchos el panel se sale del contenedor y queda casi de borde a borde («casi full-bleed», Juli), con 1,5rem de aire.
---
<Seccion id="tramo" fondo="fondo-2">
  <div class="revelar tarjeta tarjeta-panel xl:mx-[calc(50%-min(50vw-1.5rem,55rem))]">
    <MapaInteractivo {tramo} modo="scroll">
      <div slot="arriba" class="text-center xl:text-left">
        <Eyebrow centrado class="xl:justify-start">El tramo</Eyebrow>
        <h2 class="titulo mx-auto mt-3 xl:mx-0 xl:text-4xl">Tres rutas nacionales bajo una misma concesión.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-texto-2 xl:mx-0 xl:text-base">{rutas} en {provincias}. Tocá una estación para ver su ficha: en verde las que cobran hoy, en amarillo las próximas.</p>
        <div class="escalonar mt-8 grid grid-cols-3 gap-4 border-t border-borde pt-6 text-left xl:mt-6">
          <div style="--i: 0"><Mojon valor={Math.floor(tramo.km)} unidad="km" etiqueta="de rutas nacionales" animar compacto /></div>
          <div style="--i: 1"><Mojon valor={tramo.rutas.length} etiqueta="rutas: RN 9, RN 19 y RN 34" animar compacto /></div>
          <div style="--i: 2"><Mojon valor={operativas} etiqueta={`estaciones operativas de ${tramo.cabinas.length}`} animar compacto /></div>
        </div>
      </div>
      <div slot="abajo" class="flex justify-center xl:justify-start"><Boton href="/el-tramo" variante="secundario">Ver el tramo en detalle <ArrowRight size={18} aria-hidden="true" /></Boton></div>
    </MapaInteractivo>
  </div>
</Seccion>
