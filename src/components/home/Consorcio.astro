---
import ImagenAtmosfera from '@/components/ilustraciones/ImagenAtmosfera.astro';
import Mojon from '@/components/ui/Mojon.astro';
import Seccion from '@/components/ui/Seccion.astro';
import type { Empresa } from '@/lib/datos/esquemas';
import { imagenAtmosfera } from '@/lib/atmosfera';
interface Props { empresa: Empresa }
const { empresa } = Astro.props;
// Con la foto del consorcio (src/assets/atmosfera/consorcio.jpg) el panel la usa de fondo, oscurecida, detrás de los mojones.
const hayFoto = imagenAtmosfera('consorcio') !== undefined;
---
<Seccion id="consorcio" indice="06" eyebrow="Quiénes somos" titulo="Un consorcio de constructoras viales, con contrato a 20 años." intro="Covicen es la sociedad que integran las tres empresas adjudicatarias del Tramo Centro. Inversión 100% privada, sin subsidios, bajo supervisión de Vialidad Nacional." fondo="fondo-2">
  <div class="revelar tarjeta tarjeta-panel overflow-hidden">
    {hayFoto && (
      <div class="absolute inset-0 overflow-hidden rounded-[calc(var(--tarjeta-radio)-1.5px)]" aria-hidden="true">
        <ImagenAtmosfera nombre="consorcio" alt="" brillo={0.5} sizes="(min-width: 80rem) 80rem, 100vw" />
        <div class="absolute inset-0 bg-gradient-to-r from-fondo via-fondo/80 to-fondo/35"></div>
      </div>
    )}
    <div class="relative z-10 grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div class="escalonar flex gap-10">
        <div style="--i: 0"><Mojon valor={empresa.concesion.plazoAnios} unidad="años" etiqueta="de concesión" animar /></div>
        <div style="--i: 1"><Mojon valor={empresa.consorcio.length} etiqueta="empresas en el consorcio" animar /></div>
      </div>
      <ul class="escalonar divide-y divide-borde border-y border-borde lg:border-l lg:border-y-0 lg:pl-10">
        {empresa.consorcio.map((e, i) => (
          <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between" style={`--i: ${i}`}>
            <span class="font-extrabold text-texto">{e.nombre}</span>
            <span class="text-sm text-texto-2">{e.descripcion}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Seccion>
