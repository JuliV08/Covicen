---
import Eyebrow from './Eyebrow.astro';
import GrillaCinetica from '@/components/ilustraciones/GrillaCinetica.astro';
interface Props {
  id?: string;
  indice?: string;
  eyebrow?: string;
  titulo?: string;
  intro?: string;
  /** 'fondo' = liso; 'fondo-2' y 'plano' = sección oscura con la grilla cinética de fondo. */
  fondo?: 'fondo' | 'fondo-2' | 'plano';
  class?: string;
  nivel?: 'h1' | 'h2';
}
const { id, indice, eyebrow, titulo, intro, fondo = 'fondo', class: clase = '', nivel = 'h2' } = Astro.props;
const Titulo = nivel;
const cinetica = fondo !== 'fondo';
---
<section id={id} class:list={['relative py-20 md:py-28', cinetica ? 'bg-fondo-2 overflow-hidden' : 'bg-fondo', clase]}>
  {cinetica && <GrillaCinetica />}
  <div class="contenedor relative z-10">
    {(indice || eyebrow || titulo) && (
      <header class="revelar mb-12 grid gap-4 md:grid-cols-[auto_1fr] md:gap-10">
        {indice && <span class="eyebrow tabular-nums text-texto-3 md:pt-2">{indice}</span>}
        <div class="max-w-3xl">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          {titulo && <Titulo class="mt-3">{titulo}</Titulo>}
          {intro && <p class="mt-4 text-lg text-texto-2">{intro}</p>}
        </div>
      </header>
    )}
    <slot />
  </div>
</section>
