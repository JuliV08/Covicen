---
import Eyebrow from './Eyebrow.astro';
import GrillaCinetica from '@/components/ilustraciones/GrillaCinetica.astro';
// Sin número de sección (el «01», «02» que iba a la izquierda del título): se sacó de todo el sitio el 24/09/2026,
// después de que el cliente lo marcara dos veces. Sin la columna del número, el encabezado queda alineado con el
// contenido de abajo en vez de entrar sangrado.
interface Props {
  id?: string;
  eyebrow?: string;
  titulo?: string;
  intro?: string;
  /** 'fondo' = liso; 'fondo-2' y 'plano' = sección con la grilla cinética, fundida con las secciones vecinas. */
  fondo?: 'fondo' | 'fondo-2' | 'plano';
  class?: string;
  nivel?: 'h1' | 'h2';
}
const { id, eyebrow, titulo, intro, fondo = 'fondo', class: clase = '', nivel = 'h2' } = Astro.props;
const Titulo = nivel;
const cinetica = fondo !== 'fondo';
---
<section id={id} class:list={['relative py-20 md:py-28', cinetica ? 'seccion-cinetica' : 'bg-fondo', clase]}>
  {cinetica && <GrillaCinetica />}
  {cinetica && <span class="costura costura-arriba" aria-hidden="true"></span>}
  <div class="contenedor relative z-10">
    {(eyebrow || titulo) && (
      <header class="revelar mb-12 max-w-3xl">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        {titulo && <Titulo class:list={[eyebrow && 'mt-3']}>{titulo}</Titulo>}
        {intro && <p class="mt-4 text-lg text-texto-2">{intro}</p>}
      </header>
    )}
    <slot />
  </div>
  {cinetica && <span class="costura costura-abajo" aria-hidden="true"></span>}
</section>
