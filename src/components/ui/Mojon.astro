---
// `centrado` (05/10/2026): el número y su etiqueta al medio de la columna, para cuando el bloque va debajo de un
// encabezado centrado (Quiénes somos). Sin él, alineados a la izquierda, como en el panel de El tramo.
interface Props { valor: number | string; unidad?: string; etiqueta: string; animar?: boolean; class?: string; centrado?: boolean }
const { valor, unidad, etiqueta, animar = false, class: clase = '', centrado = false } = Astro.props;
// Solo enteros cuentan (contador.ts); el HTML siempre trae el número real para SEO, lectores y sin JS.
const anima = animar && typeof valor === 'number' && Number.isInteger(valor);
---
<div class:list={['mojon relative', centrado && 'text-center', clase]}>
  <p class:list={['flex items-baseline gap-2 font-extrabold leading-none tracking-[var(--tracking-titulo)] text-texto', centrado && 'justify-center']} style="font-size: clamp(2.75rem, 2rem + 3.5vw, 5.5rem)">
    <span class="tabular-nums" data-contador={anima ? valor : undefined}>{valor}</span>
    {unidad && <span class="text-[0.4em] font-medium text-texto-2">{unidad}</span>}
  </p>
  <p class="eyebrow mt-2">{etiqueta}</p>
</div>
