---
import { ArrowRight } from '@lucide/astro';
import { ruta } from '@/lib/rutas';
interface Props { href?: string; etiqueta?: string; class?: string; style?: string; variante?: 'normal' | 'vial' }
const { href, etiqueta, class: clase = '', style, variante = 'normal' } = Astro.props;
const Tag = href ? 'a' : 'article';
// Tarjeta con borde de luz fluida. h-full + flex-col: en una grilla todas miden lo mismo y "Ver más" queda al pie.
const clases = ['card tarjeta flex h-full flex-col p-6 text-texto no-underline', variante === 'vial' && 'tarjeta-vial', clase];
---
<Tag href={href ? ruta(href) : undefined} class:list={clases} style={style}>
  {etiqueta && <p class="eyebrow mb-3">{etiqueta}</p>}
  <div class="flex-1"><slot /></div>
  {href && (
    <span class="card-flecha mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-acento">Ver más <ArrowRight size={16} aria-hidden="true" /></span>
  )}
</Tag>
<style>
  .card-flecha :global(svg) { transition: transform var(--dur-ui) var(--ease-salida); }
  a.card:hover .card-flecha :global(svg) { transform: translateX(4px); }
</style>
