---
import { ArrowRight } from '@lucide/astro';
import { ruta } from '@/lib/rutas';
interface Props { href?: string; etiqueta?: string; class?: string; style?: string }
const { href, etiqueta, class: clase = '', style } = Astro.props;
const Tag = href ? 'a' : 'article';
// h-full + flex-col: en una grilla, todas las cards miden lo mismo y "Ver más" queda al pie.
const clases = ['card esquineros flex h-full flex-col rounded-md border border-borde bg-superficie/60 p-6 text-texto no-underline', clase];
---
<Tag href={href ? ruta(href) : undefined} class:list={clases} style={style} data-spotlight={href ? '' : undefined}>
  {etiqueta && <p class="eyebrow mb-3">{etiqueta}</p>}
  <div class="flex-1"><slot /></div>
  {href && (
    <span class="card-flecha mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-acento">Ver más <ArrowRight size={16} aria-hidden="true" /></span>
  )}
</Tag>
<style>
  .card {
    --mx: -200px; --my: -200px;
    background-image: radial-gradient(320px circle at var(--mx) var(--my), rgb(104 188 225 / 0.12), transparent 65%);
    transition: transform var(--dur-ui) var(--ease-salida), border-color var(--dur-ui), background-color var(--dur-ui), box-shadow var(--dur-ui);
  }
  a.card:hover, a.card:focus-visible { transform: translateY(-3px); border-color: var(--color-borde-fuerte); background-color: var(--color-superficie); box-shadow: 0 20px 40px -28px var(--color-glow); }
  .card-flecha :global(svg) { transition: transform var(--dur-ui) var(--ease-salida); }
  a.card:hover .card-flecha :global(svg) { transform: translateX(4px); }
</style>
