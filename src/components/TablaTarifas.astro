---
// Cuadro tarifario de UNA estación (o el general si no se pasa cabina): categoría, tipo de vehículo, TelePASE y pago
// electrónico en la vía (con POS; sin efectivo desde el 01/10/2026), precio al público (con IVA, como en la cabina) y sin IVA en anotación. Los textos del operador
// (avisos, vigencia, resolución) se pintan como texto, nunca set:html. Los dos precios al público salen resueltos de
// `tarifasParaCabina`: acá no se recalcula nada, así las dos columnas nunca se parten en dos números con el mismo sin IVA.
// Sin pie fijo (pedido del gerente, 24/09/2026): se fueron las tres notas del tarifario —se vaciaron en el dato— y el
// renglón «Publicado el… Fuente…», que repetía el enlace al Boletín Oficial de arriba. Los avisos
// siguen siendo del operador: si el día de mañana carga uno, aparece debajo de la tabla; si no hay, no queda nada.
// `enlazarFuente` pone el enlace al Boletín Oficial en la línea de vigencia, ARRIBA de la tabla: lo usan las páginas de
// estación. En /tarifas/ no va: el 01/10/2026 el gerente pidió sacar de esa página la línea de la resolución con el
// enlace, y con tres tablas quedaría tres veces. La URL pasa por esHttp (lib/rutas).
import IconoVehiculo from '@/components/ilustraciones/IconoVehiculo.astro';
import type { Cabina, Tarifario } from '@/lib/datos/esquemas';
import { fechaLarga, kmTexto, moneda } from '@/lib/formato';
import { esHttp } from '@/lib/rutas';
import { iconoDeTarifa, tarifasParaCabina } from '@/lib/tarifas';
interface Props { tarifario: Tarifario; cabina?: Cabina; id?: string; enlazarFuente?: boolean }
const { tarifario: t, cabina, id, enlazarFuente = false } = Astro.props;
const filas = tarifasParaCabina(t, cabina?.slug);
const vigencia = t.vigencia.desde ? `Vigencia: desde el ${fechaLarga(t.vigencia.desde)}.` : `Vigencia: ${t.vigencia.descripcion}`;
const titulo = cabina ? `Estación ${cabina.nombre} · ${cabina.ruta}${cabina.km !== null ? ` km ${kmTexto(cabina.km)}` : ''}` : 'Todas las estaciones operativas';
---
<!-- scroll-mt-32: el header es fijo (--alto-header: 7rem) y al llegar por #slug el título de la estación y la vigencia
     quedarían tapados, aterrizando sobre un thead idéntico al de las otras dos tablas. -->
<div class="revelar tabla-tarifas scroll-mt-32" {id}>
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
    <h3 class="text-xl">{titulo}</h3>
    <p class="text-sm text-texto-2">{vigencia}{t.resolucion && ` ${t.resolucion}.`}{enlazarFuente && esHttp(t.fuente.url) && <> <a href={t.fuente.url} rel="noopener noreferrer" target="_blank">Ver en el Boletín Oficial</a>.</>}</p>
  </div>
  {/* 05/10/2026 («a los cuadros tarifarios también hay que darles un reskin»): la tabla va en una tarjeta con halo;
      «Categoría» y «Tipo de vehículo» se juntan (ícono, nombre y la descripción debajo), así «Categoría 1» no se parte en
      dos renglones y los precios ganan lugar. En el celular cada fila es una tarjetita con los dos precios lado a lado,
      sin deslizar de costado. Los role explícitos sostienen la tabla para los lectores de pantalla aunque el CSS le
      cambie el display a las filas (Safari se la sacaba). */}
  {/* El recorte va en un envoltorio y no en la tarjeta: con overflow en la tarjeta se cortaba su halo, que se dibuja
      afuera. Adentro, el redondeado acompaña al de la tarjeta para que el resaltado de la última fila no asome. */}
  <section class="tarjeta" aria-label={`Tabla de tarifas, ${titulo}`}>
    <div class="overflow-hidden rounded-[calc(var(--tarjeta-radio)-1.5px)]">
    <table class="w-full border-collapse text-left" role="table">
      <caption class="sr-only">Tarifas de peaje, {titulo}, en pesos argentinos con IVA incluido. {vigencia} {t.vigencia.descripcion}</caption>
      <thead class="tabla-cabecera" role="rowgroup">
        <tr role="row"><th scope="col" role="columnheader" class="eyebrow px-5 py-4 sm:px-6">Categoría</th><th scope="col" role="columnheader" class="eyebrow px-5 py-4 text-right sm:px-6">TelePASE</th><th scope="col" role="columnheader" class="eyebrow px-5 py-4 text-right sm:px-6">Pago electrónico en la vía</th></tr>
      </thead>
      <tbody class="divide-y divide-borde" role="rowgroup">
        {filas.map((f) => {
          const telepase = f.telepaseConIva;
          const manual = f.manualConIva;
          return (
            <tr class="fila" role="row">
              <th scope="row" role="rowheader" class="px-5 py-4 font-normal sm:px-6">
                <span class="flex items-start gap-4">
                  <span class="tarifa-icono" aria-hidden="true"><IconoVehiculo icono={iconoDeTarifa(f)} class="icono" /></span>
                  <span class="min-w-0"><span class="block whitespace-nowrap font-bold text-texto">{f.nombre}</span><span class="mt-0.5 block text-sm text-texto-2">{f.descripcion}</span>{f.nota && <span class="anotacion mt-1 block text-xs text-texto-2">{f.nota}</span>}</span>
                </span>
              </th>
              <td class="precio px-5 py-4 text-right tabular-nums text-texto sm:px-6" role="cell" data-etiqueta="TelePASE">{telepase === null ? <span class="text-texto-2"><span aria-hidden="true">—</span><span class="sr-only">Sin valor publicado</span></span> : <><span class="block whitespace-nowrap text-xl font-extrabold">{moneda(telepase)}</span>{f.telepaseSinIva !== null && <span class="anotacion block whitespace-nowrap text-xs text-texto-2">{moneda(f.telepaseSinIva)} sin IVA</span>}</>}</td>
              <td class="precio px-5 py-4 text-right tabular-nums text-texto sm:px-6" role="cell" data-etiqueta="En la vía">{manual === null ? <span class="text-texto-2"><span aria-hidden="true">—</span><span class="sr-only">Sin valor publicado</span></span> : <><span class="block whitespace-nowrap text-xl font-extrabold">{moneda(manual)}</span>{f.manualSinIva !== null && <span class="anotacion block whitespace-nowrap text-xs text-texto-2">{moneda(f.manualSinIva)} sin IVA</span>}</>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
  </section>
  {t.avisos.length > 0 && <ul class="mt-6 flex flex-col gap-2 text-sm text-texto-2">{t.avisos.map((a) => <li class="flex gap-2"><span aria-hidden="true">—</span>{a}</li>)}</ul>}
</div>
<style>
  .tabla-cabecera { border-bottom: 1px solid var(--color-borde); background: color-mix(in srgb, var(--color-superficie-2) 35%, transparent); }
  .tarifa-icono {
    display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--color-acento) 28%, transparent); background: color-mix(in srgb, var(--color-acento) 9%, transparent);
    color: var(--color-acento); transition: background-color var(--dur-micro) var(--ease-salida), border-color var(--dur-micro) var(--ease-salida);
  }
  .fila { transition: background-color var(--dur-micro) var(--ease-salida); }
  .fila:hover { background: color-mix(in srgb, var(--color-acento) 6%, transparent); }
  .fila:hover .tarifa-icono { background: color-mix(in srgb, var(--color-acento) 18%, transparent); border-color: color-mix(in srgb, var(--color-acento) 55%, transparent); }
  /* En el celular: cada fila, una tarjetita. Arriba la categoría a todo el ancho; abajo los dos precios lado a lado,
     cada uno con su rótulo (el encabezado de columna queda solo para los lectores de pantalla). Solo en pantalla: una
     hoja impresa también mide menos de 768 px, y ahí va la tabla. */
  @media screen and (max-width: 47.99rem) {
    .tabla-tarifas table, .tabla-tarifas tbody { display: block; }
    .tabla-cabecera { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .fila { display: grid; grid-template-columns: 1fr 1fr; padding: 0.5rem 0 0.75rem; }
    .fila > th { grid-column: 1 / -1; }
    .fila > .precio { padding-top: 0.25rem; padding-bottom: 0.25rem; text-align: left; }
    .fila > .precio + .precio { border-left: 1px solid var(--color-borde); }
    .fila > .precio::before { content: attr(data-etiqueta); display: block; margin-bottom: 0.25rem; font-size: 0.8125rem; font-weight: 600; color: var(--color-texto-2); }
  }
</style>
