---
// Botón sol/luna. En oscuro ofrece el sol (pasar a claro); en claro, la luna. Nace `hidden`: solo JS puede hacerlo
// funcionar, así que scripts/tema.ts lo muestra al montar y pinta su estado real. El `display` lo pone el llamador
// (`inline-flex`, `hidden lg:inline-flex`): si viviera acá, la utility `hidden` del header perdería por orden del CSS.
import { Moon, Sun } from '@lucide/astro';
interface Props { class?: string }
const { class: clase = '' } = Astro.props;
---
<button type="button" class:list={['interruptor-tema h-11 w-11 items-center justify-center rounded-md border border-borde text-texto transition-colors hover:border-borde-fuerte hover:bg-superficie', clase]} data-tema-boton aria-pressed="false" aria-label="Cambiar a tema claro" hidden>
  <Sun size={20} aria-hidden="true" class="sol" />
  <Moon size={20} aria-hidden="true" class="luna" />
</button>
<script src="../scripts/tema.ts"></script>
<style>
  .interruptor-tema :global(.sol) { display: block; }
  .interruptor-tema :global(.luna) { display: none; }
  :global(html[data-tema="claro"]) .interruptor-tema :global(.sol) { display: none; }
  :global(html[data-tema="claro"]) .interruptor-tema :global(.luna) { display: block; }
</style>
