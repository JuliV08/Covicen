---
import { ArrowUpRight, ExternalLink } from '@lucide/astro';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import ImagenAtmosfera from '@/components/ilustraciones/ImagenAtmosfera.astro';
import Mojon from '@/components/ui/Mojon.astro';
import Seccion from '@/components/ui/Seccion.astro';
import { datos } from '@/lib/datos';
import { imagenInstitucional } from '@/lib/atmosfera';
import { alternarFondos } from '@/lib/fondos';
import { fechaLarga, numero } from '@/lib/formato';
import { publicado } from '@/lib/publicado';
import { conPunto } from '@/lib/texto';
const [e, tramo] = await Promise.all([datos.empresa(), datos.tramo()]);
const c = e.concesion;
const organigrama = imagenInstitucional('organigrama');
const [fAsumimos, fControla, fConsorcio, fOrganigrama] = alternarFondos([publicado.queAsumimos, publicado.quienNosControla, true, Boolean(organigrama)]);
const enumerar = (xs: string[]) => xs.join(', ').replace(/, ([^,]*)$/, ' y $1');
const rutas = `las rutas nacionales ${enumerar(c.rutas.map((r) => r.replace(/^RN /, '')))}`;
// Texto nuevo del 02/10/2026 (reunión con el gerente del 01/10): «redactarla usando de ejemplo lo que dice Corresur,
// no copiándolos». De Corresur se tomó el orden —primero para qué sirve una ruta, después quiénes somos, al final el
// compromiso con quien viaja y con los pueblos del camino—, no las frases: pasa `pnpm originalidad` contra su página
// institucional. El de antes era el de la licitación (resolución, «sociedad en formación»); la razón social y el
// CUIT se siguen publicando en el pie cuando existan.
const descripcion = `Covicen cuida ${numero(c.km)} km de ${rutas} entre Córdoba y Santa Fe: el Tramo Centro de la Red Federal de Concesiones. Detrás están ${conPunto(enumerar(e.consorcio.map((x) => x.nombre)))}`;
// Obligaciones tomadas del contrato de concesión del Tramo Centro y del contrato general.
const asumimos = [
  ['Conservar los 679 km', 'Calzada, banquinas, señalización, iluminación, desagües y forestación de las tres rutas, todos los días de los veinte años.'],
  ['Reconstruir las losas de hormigón', 'En la RN 9 y en la RN 19, los tramos de hormigón deteriorado se reconstruyen. Es una obra obligatoria del contrato.'],
  ['Pavimentar las banquinas', 'En la RN 9 entre Rosario y Carcarañá, para que detenerse sea seguro.'],
  ['Mantener el puente sobre el río Carcarañá', 'En la RN 34, con el plan de conservación que fija el contrato de concesión.'],
  ['Rehabilitar el asfalto por secciones', 'Toneladas mínimas de concreto asfáltico por año y por sección, medidas cada seis meses.'],
  ['Auxiliar gratis y a tiempo', 'Grúa y remolque para despejar la calzada, sin cargo. Vehículos livianos: 30 minutos en al menos el 90 % de los casos, y nunca más de 40. Vehículos pesados: 60 minutos en al menos el 90 % de los casos, y nunca más de 72.'],
  ['Atender el 140 con personas', 'A toda hora, todos los días del año, gratis desde cualquier celular. Nunca solo un contestador.'],
  ['Cobrar solo lo habilitado', 'El peaje se cobra donde y cuando Vialidad Nacional lo autoriza, con el cuadro que ella aprueba. Las estaciones nuevas no cobran hasta estar construidas.'],
] as const;
---
<Base titulo="Quiénes somos" {descripcion} migas={[{ nombre: 'Quiénes somos', href: '/quienes-somos' }]}>
  <Seccion nivel="h1" eyebrow="Quiénes somos" titulo="La concesionaria del Tramo Centro." intro={`En Covicen sabemos que una ruta es mucho más que asfalto: es el camino de todos los días para ir a trabajar, llevar lo que se produce y volver a casa. Por eso, desde el ${fechaLarga(c.inicioOperacion)} y durante ${c.plazoAnios} años, cuidar nuestras rutas en el centro del país es nuestro trabajo.`} class="pt-10">
    {/* Centrado bajo el encabezado (05/10/2026: «sigue flotando a la izquierda, pese a que el título ya está
        centrado»). Son tres párrafos cortos, así que el texto también va al centro, como la bajada de arriba. */}
    <div class="revelar prose-covicen mx-auto max-w-prose text-center text-lg text-texto-2">
      <p>Detrás de Covicen hay tres empresas constructoras de la región —{enumerar(e.consorcio.map((x) => x.nombre))}— que se unieron para hacerse cargo del Tramo Centro de la Red Federal de Concesiones: {numero(c.km, 2)} km de {rutas}, entre Córdoba y Santa Fe.</p>
      <p>Mantener la calzada en condiciones es solo una parte del trabajo. La otra es estar cerca de quienes viajan: que tengan auxilio cuando lo necesitan y que sepan a quién llamar.</p>
      <p>Y queremos estar a la altura de las localidades que crecieron al costado de estas rutas y viven de ellas.</p>
    </div>
    <div class="escalonar mx-auto mt-12 grid max-w-3xl gap-10 sm:grid-cols-2">
      <div style="--i: 0"><Mojon valor={c.plazoAnios} unidad="años" etiqueta={`de concesión desde el ${fechaLarga(c.inicioOperacion)}`} animar centrado /></div>
      <div style="--i: 1"><Mojon valor={tramo.cabinas.length} unidad="peajes" etiqueta="en tres rutas y dos provincias" animar centrado /></div>
    </div>
  </Seccion>

  {/* «Qué asume Covicen» y «Quién nos controla» se escondieron el 02/10/2026 (reunión con el gerente del 01/10). El
      contenido queda acá: se vuelven a mostrar con su interruptor en src/lib/publicado.ts. */}
  {publicado.queAsumimos && (
  <Seccion eyebrow="Qué asumimos" titulo="Qué asume Covicen." intro="Obligaciones del contrato de concesión, exigibles y verificables por Vialidad Nacional." fondo={fAsumimos}>
    <ol class="escalonar grid gap-4 md:grid-cols-2">
      {asumimos.map(([t, d], i) => <li class="tarjeta p-6" style={`--i: ${i}`}><span class="eyebrow tabular-nums">0{i + 1}</span><h3 class="mt-3 text-xl">{t}</h3><p class="mt-2 text-texto-2">{d}</p></li>)}
    </ol>
  </Seccion>
  )}

  {publicado.quienNosControla && (
  <Seccion eyebrow="Quién nos controla" titulo="Vialidad Nacional, con indicadores. Y vos, con este sitio." fondo={fControla}>
    <div class="revelar grid gap-8 md:grid-cols-2">
      <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-texto-2">
        <dt class="eyebrow">Régimen</dt><dd>Concesión de obra pública por peaje, inversión privada, sin subsidios del Estado.</dd>
        <dt class="eyebrow">Tramo</dt><dd>Centro: {numero(c.km, 2)} km sobre {c.rutas.join(', ')}, en {c.provincias.join(' y ')}.</dd>
        <dt class="eyebrow">Plazo</dt><dd>{c.plazoAnios} años desde el {fechaLarga(c.inicioOperacion)}.</dd>
        <dt class="eyebrow">Adjudicación</dt><dd>{fechaLarga(c.adjudicacion.fecha)}, {c.adjudicacion.resolucion}. <a href={c.adjudicacion.url} rel="noopener noreferrer" target="_blank" class="inline-flex items-center gap-1">Boletín Oficial <ExternalLink size={12} aria-hidden="true" /></a></dd>
        <dt class="eyebrow">Control</dt><dd>La Dirección Nacional de Vialidad supervisa la concesión con niveles de servicio, indicadores de desempeño e informes periódicos, y puede sancionar los incumplimientos.</dd>
      </dl>
      <div class="prose-covicen text-texto-2">
        <p><strong>Misión.</strong> Que cruzar el centro del país sea seguro, previsible y justo en lo que cuesta: rutas en condiciones, auxilio a tiempo y un peaje que se explica solo.</p>
        <p><strong>Visión.</strong> Un corredor donde cada peaje tenga una obra que lo respalde y cada persona que viaja sepa a quién llamar y qué esperar.</p>
        <p>Este sitio publica el cuadro tarifario con su resolución, el estado de las obras y los tiempos de auxilio comprometidos. Si algo de eso no se cumple, el reclamo tiene fundamento escrito.</p>
      </div>
    </div>
  </Seccion>
  )}

  <Seccion eyebrow="El consorcio" titulo="Tres empresas de construcción vial." fondo={fConsorcio}>
    <!-- Foto opcional (src/assets/atmosfera/consorcio.jpg). Sin archivo, el marco no se renderiza. -->
    <div class="revelar tarjeta mb-6 aspect-[21/9] w-full overflow-hidden p-0 empty:hidden"><div class="h-full w-full overflow-hidden rounded-[calc(var(--tarjeta-radio)-1.5px)]"><ImagenAtmosfera nombre="consorcio" alt="Tablero de un puente en construcción sobre la autopista, con una grúa torre al anochecer" sizes="(min-width: 80rem) 80rem, 100vw" /></div></div>
    {/* Cada tarjeta lleva a la web de su empresa (pedido del 01/10/2026). La tarjeta entera es el enlace: el nombre
        accesible dice adónde va y que se abre en otra pestaña. */}
    <ul class="escalonar grid gap-4 md:grid-cols-3">{e.consorcio.map((s, i) => (
      <li class="tarjeta p-0" style={`--i: ${i}`}>
        {s.url ? (
          <a href={s.url} rel="noopener noreferrer" target="_blank" class="empresa flex h-full flex-col p-6 no-underline" aria-label={`${s.nombre}: su sitio web (se abre en otra pestaña)`}>
            <div class="flex items-start justify-between gap-3"><h3 class="text-xl">{s.nombre}</h3><ArrowUpRight size={20} class="flecha mt-0.5 shrink-0 text-acento" aria-hidden="true" /></div>
            <p class="mt-2 text-texto-2">{s.descripcion}</p>
            <span class="mt-4 text-sm font-semibold text-acento">{new URL(s.url).hostname.replace(/^www\./, '')}</span>
          </a>
        ) : (
          <div class="p-6"><h3 class="text-xl">{s.nombre}</h3><p class="mt-2 text-texto-2">{s.descripcion}</p></div>
        )}
      </li>
    ))}</ul>
  </Seccion>

  {organigrama && (
    <Seccion eyebrow="Organigrama" titulo="Cómo estamos organizados." fondo={fOrganigrama}>
      <figure class="revelar tarjeta overflow-hidden p-2"><Image src={organigrama} alt="Organigrama de Covicen" widths={[640, 1024, 1600]} sizes="(min-width: 80rem) 80rem, 100vw" class="h-auto w-full rounded-[calc(var(--tarjeta-radio)-1.5px)] bg-white" /></figure>
    </Seccion>
  )}
</Base>
<style>
  .empresa .flecha { transition: transform var(--dur-ui) var(--ease-salida); }
  .empresa:hover .flecha, .empresa:focus-visible .flecha { transform: translate(2px, -2px); }
  .empresa:focus-visible { outline-offset: -2px; border-radius: inherit; }
</style>
