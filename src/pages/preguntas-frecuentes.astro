---
import Base from '@/layouts/Base.astro';
import Faq from '@/components/Faq.astro';
import Seccion from '@/components/ui/Seccion.astro';
import { datos } from '@/lib/datos';
import { preguntasPublicables } from '@/lib/faq';
import { jsonLdFaq } from '@/lib/seo';
// El filtro va acá arriba y no en cada uso: el JSON-LD tiene que salir de la MISMA lista que la página.
// Si se filtrara solo lo visible, las respuestas escondidas seguirían yendo a Google en el FAQPage.
const preguntas = preguntasPublicables(await datos.faq());
const temas = ([['general', 'General'], ['tarifas', 'Tarifas'], ['peajes', 'Peajes'], ['pago', 'Pago'], ['servicios', 'Servicios'], ['empresa', 'Empresa']] as const)
  .map(([id, nombre]) => ({ id, nombre, lista: preguntas.filter((p) => p.tema === id) }))
  .filter((t) => t.lista.length > 0);
// 05/10/2026: «son bloques cuadrados con un gran espacio sobrante a la derecha». Desde 1024 px, el índice de temas al
// costado, fijo al bajar y con el tema en el que estás marcado (scripts/faq-indice.ts), y las preguntas como tarjetas en
// una columna que se llena entera. Más angosto, los temas son una tira fija debajo del header.
// La tira del celular queda debajo del header (--alto-header) y mide ~3,75rem: las anclas aterrizan debajo de las dos.
const anclaTapada = 'scroll-mt-[calc(var(--alto-header)+5rem)] lg:scroll-mt-[calc(var(--alto-header)+2rem)]';
---
<Base titulo="Preguntas frecuentes" descripcion="Respuestas sobre el peaje del Tramo Centro: cuánto cuesta, desde cuándo se cobra, dónde están las estaciones, TelePASE, emergencias y reclamos." jsonLd={[jsonLdFaq(preguntas)]} migas={[{ nombre: 'Preguntas frecuentes', href: '/preguntas-frecuentes' }]}>
  <Seccion nivel="h1" eyebrow="Preguntas frecuentes" titulo="Lo que más se pregunta." class="pt-10">
    <div class="mx-auto grid max-w-5xl grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-14">
      <nav aria-label="Temas" class="faq-temas sticky top-[var(--alto-header)] z-30 -mx-5 border-b border-borde bg-fondo/85 px-5 py-3 backdrop-blur lg:top-[calc(var(--alto-header)+2rem)] lg:mx-0 lg:self-start lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none" data-faq-indice>
        <p class="eyebrow mb-4 hidden lg:block">Temas</p>
        <ul class="flex gap-2 overflow-x-auto lg:flex-col lg:gap-1 lg:overflow-visible">
          {temas.map((t) => <li class="shrink-0"><a href={`#tema-${t.id}`} class="tema-enlace" data-tema={t.id}><span>{t.nombre}</span><span class="tema-cantidad tabular-nums" aria-hidden="true">{t.lista.length}</span><span class="sr-only">, {t.lista.length} preguntas</span></a></li>)}
        </ul>
      </nav>
      <div class="grid gap-14">
        {temas.map((t) => (
          <section id={`tema-${t.id}`} class={anclaTapada} data-tema-seccion={t.id}><h2 class="titulo revelar mb-5 text-2xl">{t.nombre}</h2><Faq preguntas={t.lista} /></section>
        ))}
      </div>
    </div>
  </Seccion>
</Base>
<script src="../scripts/faq-indice.ts"></script>
<style>
  .tema-enlace {
    position: relative; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.5rem 0.875rem; border: 1px solid var(--color-borde); border-radius: 999px;
    font-size: 0.875rem; font-weight: 600; white-space: nowrap; color: var(--color-texto-2); text-decoration: none;
    transition: color var(--dur-micro) var(--ease-salida), background-color var(--dur-micro) var(--ease-salida), border-color var(--dur-micro) var(--ease-salida);
  }
  .tema-enlace:hover { color: var(--color-texto); border-color: var(--color-borde-fuerte); }
  .tema-cantidad { min-width: 1.5rem; padding: 0.0625rem 0.4rem; border-radius: 999px; text-align: center; font-size: 0.8125rem; background: var(--color-superficie-2); color: var(--color-texto-2); }
  .tema-enlace[aria-current="true"] { color: var(--color-texto); border-color: color-mix(in srgb, var(--color-acento) 55%, transparent); background: color-mix(in srgb, var(--color-acento) 14%, transparent); }
  .tema-enlace[aria-current="true"] .tema-cantidad { background: var(--color-acento); color: var(--color-sobre-acento); }
  /* Desde 1024, una lista: renglones en vez de píldoras, con una raya del lado del tema marcado. */
  @media (min-width: 64rem) {
    .tema-enlace { padding: 0.625rem 0.875rem; border-color: transparent; border-radius: 12px; font-size: 1rem; }
    .tema-enlace:hover { background: var(--color-superficie); border-color: transparent; }
    .tema-enlace[aria-current="true"]::before {
      content: ""; position: absolute; left: 0; top: 0.625rem; bottom: 0.625rem; width: 3px; border-radius: 3px;
      background: var(--color-acento); box-shadow: 0 0 12px color-mix(in srgb, var(--color-acento) 60%, transparent);
    }
  }
</style>
