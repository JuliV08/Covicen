---
import Base from '@/layouts/Base.astro';
import Canales from '@/components/Canales.astro';
import Seccion from '@/components/ui/Seccion.astro';
import Senal from '@/components/ui/Senal.astro';
import { datos } from '@/lib/datos';
import { alternarFondos } from '@/lib/fondos';
import { publicado } from '@/lib/publicado';
import { serviciosPublicables } from '@/lib/servicios';
const [servicios, contacto] = await Promise.all([datos.servicios(), datos.contacto()]);
const gratuitos = serviciosPublicables(servicios).filter((s) => s.gratuito);
const onerosos = serviciosPublicables(servicios).filter((s) => !s.gratuito);
// Reunión con el gerente del 01/10/2026: se esconden «Servicios que se cobran» y la tabla de canales (que sigue en
// Contacto y en Emergencias). Los fondos se alternan sobre lo que se ve (lib/fondos.ts).
const [fGratuitos, fConCosto, fCanales] = alternarFondos([true, publicado.serviciosConCosto, publicado.canalesEnServicios]);
// La descripción para buscadores ofrece solo lo que la página muestra.
const descripcion = `Servicios de Covicen en el Tramo Centro: emergencias 140, grúa y remolque gratuitos con tiempos comprometidos, móviles de seguridad vial${publicado.telepaseSinCosto ? ', TelePASE sin costo' : ''} y atención al usuario${publicado.serviciosConCosto ? ', y qué servicios se cobran' : ''}.`;
---
<Base titulo="Servicios al usuario" {descripcion} migas={[{ nombre: 'Servicios', href: '/servicios' }]}>
  {/* La bajada decía «El contrato de concesión obliga a prestarlos y a informar cuáles son gratuitos y cuáles tienen
      costo». Pedido del 01/10/2026: algo como «A continuación te informamos los servicios que tenés disponibles», en el
      tono del sitio. */}
  <Seccion nivel="h1" eyebrow="Servicios" titulo="Servicios al usuario." intro="Estos son los servicios que tenés a disposición cuando viajás por nuestras rutas." class="pt-10 pb-0" />
  <Seccion id="gratuitos" eyebrow="Sin costo" titulo="Servicios gratuitos." fondo={fGratuitos}>
    <ul class="escalonar grid gap-4 md:grid-cols-2">
      {gratuitos.map((s, i) => (
        <li class="tarjeta p-6" style={`--i: ${i}`}>
          <div class="flex items-start justify-between gap-3"><h3 class="text-xl">{s.nombre}</h3><Senal variante="ok">Gratis</Senal></div>
          <p class="mt-2 text-texto-2">{s.descripcion}</p>
          {s.alcance && <p class="mt-2 text-texto-2"><span class="text-texto">Alcance:</span> {s.alcance}</p>}
          {s.tiempos && <ul class="mt-3 flex flex-col gap-1 text-texto-2">{s.tiempos.map((t) => <li class="flex gap-2"><span aria-hidden="true">—</span>{t}</li>)}</ul>}
        </li>
      ))}
    </ul>
  </Seccion>
  {publicado.serviciosConCosto && (
  <Seccion id="con-costo" eyebrow="Con costo" titulo="Servicios que se cobran." intro="Estos servicios no están cubiertos por la tarifa de peaje." fondo={fConCosto}>
    <ul class="escalonar grid gap-4 md:grid-cols-2">
      {onerosos.map((s, i) => <li class="tarjeta p-6" style={`--i: ${i}`}><div class="flex items-start justify-between gap-3"><h3 class="text-xl">{s.nombre}</h3><Senal variante="frio">Con costo</Senal></div><p class="mt-2 text-texto-2">{s.descripcion}</p></li>)}
    </ul>
  </Seccion>
  )}
  {/* Título y bajada con los cambios del 01/10/2026 («Canales de atención.», sin bajada), para cuando vuelva. */}
  {publicado.canalesEnServicios && (
  <Seccion id="canales" eyebrow="Atención" titulo="Canales de atención." fondo={fCanales}>
    <div class="revelar"><Canales canales={contacto.canales} /></div>
  </Seccion>
  )}
  {/* La sección «Más adelante» (oficina virtual y seguimiento de reclamos, las dos «Próximamente») se sacó el
      24/09/2026 por pedido del gerente: la página dice lo que hay, no lo que algún día se suma. */}
</Base>
